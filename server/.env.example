PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tledb?retryWrites=true&w=majority
MONGO_URI_LOCAL=mongodb://localhost:27017/tledb
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
GROQ_API_KEY=your_groq_api_key_here
FRONTEND_ORIGIN_ALLOWLIST=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
API_JSON_LIMIT=100kb
AUTH_JSON_LIMIT=10kb
AI_JSON_LIMIT=25kb
